# Production environment variables for Vercel
# Copy these to Vercel dashboard > Settings > Environment Variables

APP_URL=https://your-project.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME="Libro de Reclamaciones"

# JWT Secret for stateless authentication (generar una clave aleatoria larga)
# Puedes generar una con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambiar-a-una-clave-secreta-muy-larga-en-produccion