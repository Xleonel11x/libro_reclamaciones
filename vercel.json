{
  "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction",
  "devCommand": "php -S localhost:3000 -t public",
  "installCommand": "composer install --no-dev --optimize-autoloader --no-interaction",
  "regions": ["gru1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/assets/([^.]+\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/assets/$2"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/pdf/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}