{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,vendor/**,.git/**,tests/**,README.md,composer.lock}"
    }
  },
  "routes": [
    {
      "src": "^/assets/([^.]+\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2))$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/public/assets/$1"
    },
    {
      "src": "^/(css|js|images|fonts|favicon)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/(.*)\\.(ico|txt|webp|css|js|png|jpg|jpeg|gif|svg|woff|woff2)$",
      "dest": "/public/$1.$2"
    },
    { "src": "/api/(.*)", "dest": "/api/index.php" },
    { "src": "/admin/(.*)", "dest": "/api/index.php" },
    { "src": "/pdf/(.*)", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}